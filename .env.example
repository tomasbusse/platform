# Convex Deployment URL
# Obtain this URL by running: npx convex dev
# The URL will be provided in the CLI output and can also be found in your Convex dashboard
# Format: https://your-project.convex.cloud
VITE_CONVEX_URL=https://your-project.convex.cloud

# Instructions:
# 1. Copy this file to .env.local
# 2. Run 'npx convex dev' to get your deployment URL
# 3. Replace the placeholder URL above with your actual Convex deployment URL
